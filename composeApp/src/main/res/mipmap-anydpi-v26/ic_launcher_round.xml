<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. The system masks the foreground to the launcher's shape, so the mark sits
  inside the 72dp safe zone of the 108dp canvas rather than filling it.

  monochrome drives Android 13+ themed icons: the system discards its colour and tints the
  alpha, so that layer is a silhouette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
