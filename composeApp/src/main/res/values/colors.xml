<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Azphalt ink: the fixed dark of the palette (Azphalt.Ink). -->
    <color name="azphalt_ink">#1E1A17</color>
    <!--
      Mustard, the default Azphalt ground (Azphalt.grounds[0], about 55% of launches). The window shows this
      until Compose draws; HG2GuiTheme / Window.applyAzphaltGround then repaint the window with whichever
      ground was actually rolled. The other grounds are Kotlin-side only because they rotate per launch.
    -->
    <color name="azphalt_page_default">#E8C81E</color>
    <!-- Platform widget hints (Compose draws its own). Ink at 70% so it reads on every light ground. -->
    <color name="hint_color">#B31E1A17</color>
</resources>
