<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The app theme. Azphalt has no system light/dark mode: it has one rolled "ground" per launch, painted by
      Compose (HG2GuiTheme). This theme therefore only has to be a neutral, edge-to-edge base for the first
      frame, the platform dialogs and the splash: Mustard (the most likely ground) as the window colour, with
      the Light AppCompat parent that matches it. The window is repainted to the real ground by
      Window.applyAzphaltGround as soon as the activity composes.

      No values-night variant on purpose: the app never follows the system night mode, so a night theme would
      just re-introduce a dark window under a light ground.
    -->
    <style name="Custom.Solid" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/azphalt_page_default</item>
        <item name="android:colorBackground">@color/azphalt_page_default</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
